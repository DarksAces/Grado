<odoo>
    <record id="view_library_resource_tree" model="ir.ui.view">
        <field name="name">library.resource.tree</field>
        <field name="model">library.resource</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="category_id"/>
                <field name="resource_type"/>
            </tree>
        </field>
    </record>

    <record id="view_library_resource_form" model="ir.ui.view">
        <field name="name">library.resource.form</field>
        <field name="model">library.resource</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="resource_type"/>
                        <field name="link" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
